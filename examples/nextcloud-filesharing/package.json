{
  "name": "@openuji/example-nextcloud-filesharing",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@openuji/journey-observer-docker": "workspace:*",
    "@openuji/journey-executor-playwright": "workspace:*",
    "@openuji/journey-vendor-nextcloud": "workspace:*",
    "@openuji/journey-execution-model": "workspace:*",
    "@openuji/journey-model-ujg": "workspace:*",
    "@openuji/journey-observer-axe": "workspace:*",
    "@openuji/journey-profiles": "workspace:*",
    "@openuji/journey-runner": "workspace:*",
    "@openuji/journey-executor-appium": "workspace:*",
    "@openuji/journey-platform-web": "workspace:*",
    "@openuji/journey-platform-ios": "workspace:*",
    "@openuji/journey-observer-android-accessibility": "workspace:*",
    "@openuji/journey-observer-ios-accessibility": "workspace:*",
    "@openuji/journey-cli": "workspace:*",
    "@openuji/journey-host": "workspace:*",
    "@openuji/journey-observer-ux": "workspace:*",
    "@openuji/journey-report-axe": "workspace:*",
    "@openuji/journey-report-android": "workspace:*",
    "@openuji/journey-report-ios": "workspace:*",
    "@openuji/journey-observer-operability": "workspace:*",
    "@openuji/journey-report-operability": "workspace:*",
    "@openuji/journey-service-android": "workspace:*",
    "@openuji/journey-service-ios": "workspace:*",
    "@openuji/journey-service-git": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.3"
  },
  "scripts": {
    "e2e": "journey-mesh test mesh.yaml --test browser-sharing",
    "e2e:headed": "HEADLESS=false journey-mesh test mesh.yaml --test browser-sharing",
    "e2e:report": "pnpm --filter @openuji/report-renderer serve test-results",
    "e2e:android": "journey-service-android android check mesh.yaml --require-locale en-US && journey-mesh test mesh.yaml --test native-recipient-sharing",
    "e2e:ios": "journey-service-ios ios check mesh.yaml --require-locale en-US && journey-mesh test mesh.yaml --test ios-recipient-sharing",
    "android:check": "journey-service-android android check mesh.yaml --require-locale en-US",
    "android:up": "pnpm run android:check && journey-mesh services up mesh.yaml --service android",
    "android:down": "journey-mesh services down mesh.yaml --service android",
    "ios:check": "journey-service-ios ios check mesh.yaml --require-locale en-US",
    "ios:up": "pnpm run ios:check && journey-mesh services up mesh.yaml --service ios",
    "ios:down": "journey-mesh services down mesh.yaml --service ios",
    "appium:up": "pnpm run android:check && journey-mesh services up mesh.yaml --service appium",
    "appium:down": "journey-mesh services down mesh.yaml --service appium",
    "appium:ios:up": "pnpm run ios:check && journey-mesh services up mesh.yaml --service appium-ios",
    "appium:ios:down": "journey-mesh services down mesh.yaml --service appium-ios",
    "journey:test": "journey-mesh test mesh.yaml",
    "journey:validate": "journey-mesh validate mesh.yaml",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "e2e:report:markdown": "pnpm --filter @openuji/report-renderer markdown test-results"
  }
}
