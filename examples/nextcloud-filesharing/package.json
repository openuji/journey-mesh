{
  "name": "@openuji/example-nextcloud-filesharing",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@openuji/journey-adapter-playwright": "workspace:*",
    "@openuji/journey-driver-nextcloud": "workspace:*",
    "@openuji/journey-execution-model": "workspace:*",
    "@openuji/journey-model-ujg": "workspace:*",
    "@openuji/journey-observer-axe": "workspace:*",
    "@openuji/journey-profiles": "workspace:*",
    "@openuji/journey-runner": "workspace:*",
    "@openuji/journey-adapter-appium": "workspace:*",
    "@openuji/journey-driver-web": "workspace:*",
    "@openuji/journey-driver-android": "workspace:*",
    "@openuji/journey-observer-android-accessibility": "workspace:*",
    "@openuji/journey-cli": "workspace:*",
    "@openuji/journey-runtime": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.3"
  },
  "scripts": {
    "e2e": "journey-mesh test mesh.yaml --test browser-sharing",
    "e2e:headed": "HEADLESS=false journey-mesh test mesh.yaml --test browser-sharing",
    "e2e:report": "journey-mesh report test-results",
    "stack:provision": "sh deployment/scripts/provision.sh",
    "stack:reset": "sh deployment/scripts/reset.sh",
    "stack:seed": "sh deployment/scripts/seed.sh",
    "stack:up": "sh deployment/scripts/up.sh",
    "e2e:android": "node android/check-runtime.mjs && journey-mesh test mesh.yaml --test native-recipient-sharing",
    "android:apk": "node android/download-apk.mjs",
    "android:check": "node android/check-runtime.mjs",
    "android:up": "node android/check-runtime.mjs && node android/download-apk.mjs && journey-mesh runtime up mesh.yaml --runtime android",
    "android:down": "journey-mesh runtime down mesh.yaml --runtime android",
    "appium:up": "node android/check-runtime.mjs && node android/download-apk.mjs && journey-mesh runtime up mesh.yaml --runtime appium",
    "appium:down": "journey-mesh runtime down mesh.yaml --runtime appium",
    "journey:test": "journey-mesh test mesh.yaml",
    "journey:validate": "journey-mesh validate mesh.yaml",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --test deployment/*.test.mjs && node --import tsx --test test/*.test.ts"
  }
}
