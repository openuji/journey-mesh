POSTGRES_DB=postgres
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=nextcloud

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=UjgAdminPass2026!

# Account and database defaults shared by the isolated test stacks.
NEXTCLOUD_ALICE_USER=alice
NEXTCLOUD_ALICE_PASSWORD=UjgAlicePass2026!
NEXTCLOUD_ALICE_DB=nextcloud_alice
NEXTCLOUD_ALICE_DB_USER=nextcloud_alice
NEXTCLOUD_ALICE_DB_PASSWORD=nextcloud_alice

NEXTCLOUD_BOB_USER=bob
NEXTCLOUD_BOB_PASSWORD=UjgBobPass2026!
NEXTCLOUD_BOB_DB=nextcloud_bob
NEXTCLOUD_BOB_DB_USER=nextcloud_bob
NEXTCLOUD_BOB_DB_PASSWORD=nextcloud_bob

# Default per-test timeout (ms), matching mesh.yaml fallback.
UJG_EXAMPLE_TIMEOUT_MS=900000

# iOS Simulator shares the macOS host network stack, so host.docker.internal works by default.
NEXTCLOUD_IOS_STACK_HOST=host.docker.internal

# For Android native tests, set a host IPv4 reachable from the browser, both containers,
# and the emulator in deployment/.env or the shell. There is no default/discovery.
# NEXTCLOUD_ANDROID_STACK_HOST=192.168.1.10
# Ports and project defaults are declared in mesh.yaml and may be overridden:
# NEXTCLOUD_WEB_ALICE_PORT=18081
# NEXTCLOUD_WEB_BOB_PORT=18082
# NEXTCLOUD_ANDROID_ALICE_PORT=18083
# NEXTCLOUD_ANDROID_BOB_PORT=18084
# NEXTCLOUD_IOS_ALICE_PORT=18085
# NEXTCLOUD_IOS_BOB_PORT=18086
