NEXTCLOUD_ALICE_HOST=host.docker.internal
NEXTCLOUD_ALICE_PORT=18081
NEXTCLOUD_ALICE_URL=http://host.docker.internal:18081
NEXTCLOUD_ALICE_USER=alice
NEXTCLOUD_ALICE_PASSWORD=UjgAlicePass2026!
NEXTCLOUD_ALICE_DB=nextcloud_alice
NEXTCLOUD_ALICE_DB_USER=nextcloud_alice
NEXTCLOUD_ALICE_DB_PASSWORD=nextcloud_alice

NEXTCLOUD_BOB_HOST=host.docker.internal
NEXTCLOUD_BOB_PORT=18082
