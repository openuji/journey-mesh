{
  "name": "@openuji/journey-runner-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "tsc -b packages/journey-evidence packages/journey-runner packages/journey-model-ujg packages/journey-profiles examples/nextcloud-filesharing",
    "typecheck": "tsc -b --pretty false",
    "lint": "node scripts/lint.mjs",
    "test": "node --import tsx tests/run-tests.ts",
    "example:nextcloud:dummy": "node --import tsx examples/nextcloud-filesharing/run.ts"
  },
  "devDependencies": {
    "@openuji/journey-evidence": "workspace:*",
    "@openuji/journey-model-ujg": "workspace:*",
    "@openuji/journey-profiles": "workspace:*",
    "@openuji/journey-runner": "workspace:*",
    "@types/node": "^22.13.14",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
