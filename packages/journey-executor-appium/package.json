{
  "name": "@openuji/journey-executor-appium",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ios": "./src/ios.ts",
    "./observation": "./src/observation.ts",
    "./plugin": "./src/plugin.ts",
    "./ios/plugin": "./src/ios-plugin.ts",
    "./service": "./src/runtime/plugin.ts",
    "./ios/service": "./src/runtime/ios-plugin.ts"
  },
  "types": "./src/index.ts",
  "bin": {
    "journey-executor-appium": "./bin/journey-executor-appium.mjs"
  },
  "dependencies": {
    "@openuji/journey-core": "workspace:*",
    "@openuji/journey-execution-model": "workspace:*",
    "@openuji/journey-platform-android": "workspace:*",
    "@openuji/journey-platform-ios": "workspace:*",
    "@openuji/journey-plugin": "workspace:*",
    "@openuji/journey-runner": "workspace:*",
    "@openuji/journey-toolkit-android": "workspace:*",
    "@openuji/journey-toolkit-ios": "workspace:*",
    "appium": "3.9.0",
    "appium-uiautomator2-driver": "8.7.3",
    "appium-xcuitest-driver": "12.22.8",
    "webdriverio": "9.20.0"
  },
  "devDependencies": {
    "@openuji/journey-run-record": "workspace:*",
    "@xmldom/xmldom": "0.9.12",
    "tsx": "^4.20.3",
    "xpath": "0.0.34",
    "yaml": "2.9.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  }
}
