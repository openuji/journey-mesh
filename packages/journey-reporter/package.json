{
  "name": "@openuji/journey-reporter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model/index.ts",
    "./interpreter": "./src/interpreter.ts"
  },
  "dependencies": {
    "@openuji/journey-core": "workspace:*",
    "@openuji/journey-execution-model": "workspace:*",
    "@openuji/journey-runner": "workspace:*",
    "@openuji/journey-plugin": "workspace:*",
    "@openuji/journey-run-record": "workspace:*",
    "@openuji/journey-path": "workspace:*",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "ajv": "^8.17.1",
    "ts-json-schema-generator": "2.4.0",
    "@openuji/journey-model-ujg": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "schema": "ts-json-schema-generator --path src/model/types.ts --tsconfig tsconfig.json --type ReportModelDocument --no-type-check --out schema/report-model.schema.json"
  },
  "types": "./src/index.ts"
}
