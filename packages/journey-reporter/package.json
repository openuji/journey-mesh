{
  "name": "@openuji/journey-reporter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./paths": "./src/paths.ts",
    "./vite-assets": "./src/vite-assets.ts"
  },
  "dependencies": {
    "@openuji/journey-core": "workspace:*",
    "@openuji/journey-execution-model": "workspace:*",
    "@openuji/journey-runner": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "@openuji/journey-plugin": "workspace:*",
    "@openuji/journey-path": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "playwright": "^1.61.1",
    "vite": "^7.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@openuji/journey-model-ujg": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm build:app",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.browser.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:browser": "node --import tsx --test test/*.test.mts",
    "build:app": "vite build",
    "dev": "vite --host 127.0.0.1"
  }
}
