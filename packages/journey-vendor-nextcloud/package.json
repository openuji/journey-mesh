    "./android": "./src/android/client.ts",
    "./android/plugin": "./src/android/plugin.ts",
    "./federated-sharing": "./src/environments/federated-sharing/environment.ts",
    "./federated-sharing/plugin": "./src/environments/federated-sharing/plugin.ts",
    "./stack": "./src/services/stack/stack.ts",
    "./stack/service": "./src/services/stack/plugin.ts",
    "./app-build/service": "./src/services/app-build/plugin.ts",
    "./server-build/service": "./src/services/server-build/plugin.ts",
    "./app-install/service": "./src/services/app-install/plugin.ts",
    "./stack-built/service": "./src/services/stack-built/plugin.ts"
  },
  "types": "./src/index.ts",
  "dependencies": {
    "@openuji/journey-service-docker": "workspace:*",
    "@openuji/journey-platform-web": "workspace:*",
