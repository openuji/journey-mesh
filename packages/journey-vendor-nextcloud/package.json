    "@openuji/journey-runner": "workspace:*",
    "@openuji/journey-plugin": "workspace:*",
    "@openuji/journey-service-git": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "@openuji/journey-run-record": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
